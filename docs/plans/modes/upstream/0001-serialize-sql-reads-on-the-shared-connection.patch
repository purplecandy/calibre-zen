+def sql_read_api[T: types.FunctionType](f: T) -> T:
+    """
+    For a read_api method that runs SQL on the backend's connection. Many
+    threads can hold the read lock at once, but apsw allows only one call at
+    a time on a connection, so these take the connection lock too, always
+    inside the read lock. Nothing inside it takes another lock.
+    """
+
+    @wraps(f)
+    def serialized(self, *args, **kwargs):
+        with self.backend.connection_lock:
+            return f(self, *args, **kwargs)
+
+    return read_api(serialized)
+
