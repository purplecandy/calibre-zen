@@ -20,6 +22,36 @@ class UrlForCallable(Protocol):
     def __call__(self, route: str | None, **kwargs: Any) -> str: ...
 
 
+def read_locked(method):
+    """
+    Run a Context method holding the library's read lock, taken before
+    Context.lock. Context.lock guards the category and search caches, and
+    whoever holds it calls into the library, so it is always taken after the
+    read lock: request handlers such as get_books hold the read lock and then
+    call search(). Taking the two in the other order deadlocks once a writer
+    is queued, because new readers wait behind it (see SHLock).
+
+    Cache.get_categories() repairs a broken link table by taking the write
+    lock, which a thread holding the read lock cannot. When that is what went
+    wrong, the repair is done here holding no lock at all, so that it waits
+    for the write lock outside the cycle, and the method runs again.
+    """
+
+    @wraps(method)
+    def wrapper(self, request_data, db, *args, **kwargs):
+        try:
+            with db.safe_read_lock:
+                return method(self, request_data, db, *args, **kwargs)
+        except LockingError as err:
+            if not isinstance(err.__context__, InvalidLinkTable):
+                raise
+        db.get_categories()
+        with db.safe_read_lock:
+            return method(self, request_data, db, *args, **kwargs)
+
+    return wrapper
+
+
 class Context:
