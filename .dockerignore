# The Docker image (packaging/docker/Dockerfile) is built from the repository
# root and needs only these four folders. Everything else, .git and the
# downloaded installers in .calibre-zen/ above all, stays out of the context.
*
!packaging
!resources
!src
!web

**/__pycache__
**/*.pyc
**/*_ui.py
**/.DS_Store
packaging/**/build
packaging/**/dist

# The web app is built inside the image, from web/; a local build or its
# Node modules must not get in.
web/node_modules
web/.astro
web/test-results
web/playwright-report
src/calibre_zen/web/dist

# Built in a development tree, never tracked (see .gitignore). Without git in
# the build, package.sh lays any resources/ file that differs from the
# binary's over it, so a stale local build of one of these must not get in.
src/calibre/plugins
resources/images.qrc
resources/icons.rcc
resources/localization
resources/hyphenation
resources/scripts.calibre_msgpack
resources/changelog.json
resources/ebook-convert-complete.calibre_msgpack
resources/builtin_recipes.xml
resources/builtin_recipes.zip
resources/template-functions.json
resources/editor-functions.json
resources/user-manual-translation-stats.json
resources/editor.js*
resources/viewer.js*
resources/viewer.html
resources/content-server/index-generated.html
resources/content-server/index.js.map
resources/content-server/locales.zip
resources/mathjax
resources/fonts/liberation
resources/mozilla-ca-certs
resources/user-agent-data.json
resources/piper-voices.json
