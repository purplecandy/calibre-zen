/* Item views */

QAbstractItemView {
    background-color: palette(base);
    alternate-background-color: $alt;
    border: 1px solid $border;
    selection-background-color: $accent;
    selection-color: $accent_text;
    outline: none;
}

QListView, QTreeView { border-radius: ${radius_panel}px; }
QListView::item, QTreeView::item { border-radius: ${radius_row}px; padding: 2px; }
QListView::item:hover, QTreeView::item:hover { background-color: $hover; }
/* An unfocused view's selection is a weaker accent, not a different idea: the
   text and the glyph on it stay HighlightedText, because Qt hands an item view
   the same icon mode whether or not it has focus, so a rule that flipped only
   the text would leave every icon disagreeing with the label beside it. */
QListView::item:selected:!active, QTreeView::item:selected:!active {
    background-color: $selected_soft;
}

/* Tree expanders. Qt's are filled triangles; these are the same chevrons every
   other indicator uses. Both branch states have to be given an image or Qt
   keeps drawing its own for the state that was left out. */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: $mark_chevron_right;
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: $mark_chevron_down;
}

QHeaderView { background-color: transparent; border: none; }
QHeaderView::section {
    background-color: $window;
    color: $muted;
    border: none;
    border-bottom: 1px solid $border;
    border-right: 1px solid $border_weak;
    padding: $pad_header;
    font-size: ${font_size_caption}px;
}
QHeaderView::section:hover { background-color: $button_hover; color: palette(window-text); }
QHeaderView::section:last, QHeaderView::section:only-one { border-right: none; }

QHeaderView::up-arrow, QHeaderView::down-arrow {
    subcontrol-origin: content;
    subcontrol-position: center right;
    width: ${indicator_size}px;
    height: ${indicator_size}px;
}
QHeaderView::up-arrow { image: $mark_chevron_up; }
QHeaderView::down-arrow { image: $mark_chevron_down; }
