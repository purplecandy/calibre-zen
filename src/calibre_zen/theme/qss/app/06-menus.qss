/* Menus */

QMenu {
    background-color: $menu_bg;
    border: 1px solid $border_strong;
    border-radius: ${radius_panel}px;
    padding: $pad_menu;
}

QMenu::item {
    background-color: transparent;
    border-radius: ${radius_row}px;
    padding: $pad_menu_item;
    margin: 1px 2px;
}
QMenu::item:selected { background-color: $accent; color: $accent_text; }
QMenu::item:disabled { color: $muted; }
QMenu::separator { height: 1px; background: $border; margin: 4px 10px; }
QMenu::icon { left: 7px; }
/* A checkable entry that carries an icon has no room for a tick, so the icon
   itself says on: the filled outline the status bar's layout toggles wear
   while their panel is showing. The Layout menu is the one that needs it. */
QMenu::icon:checked {
    background-color: $pressed;
    border: 1px solid $border;
    border-radius: ${radius_row}px;
    padding: 2px;
}
QMenu::right-arrow {
    margin-right: 8px;
    width: ${indicator_size}px;
    height: ${indicator_size}px;
    image: $mark_chevron_right;
}

QMenuBar { background-color: transparent; border: none; padding: 1px 2px; }
QMenuBar::item { background-color: transparent; border-radius: ${radius_row}px; padding: $pad_menubar_item; }
QMenuBar::item:selected { background-color: $hover; }
QMenuBar::item:pressed { background-color: $pressed; }
