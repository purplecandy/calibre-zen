/* The centre pane -- calibre_zen/centre/.

   The book table's rows are painted by ZenCellDelegate, one cell at a time,
   and a row has to read as a single card across every one of them. So the
   item's own background is taken away here and the delegate draws the card
   instead: adjacent cells fill identically with no gap between them, and only
   the two outer ends are rounded, which is what makes N cells look like one
   rounded row. Leave these transparent or the delegate's card is painted over
   by Qt's own item panel on every cell but the first. */
QTableView#library_view::item,
QTableView#library_view::item:hover,
QTableView#library_view::item:selected,
QTableView#library_view::item:selected:!active {
    background: transparent;
    border: none;
}

QTableView#library_view {
    background-color: $window;
    border: none;
    border-radius: 0;
}

/* The strip above the list: search on the left, the view switcher on the
   right. The search bar is calibre's own, moved in whole, so it keeps its
   objectName and everything already styled about it. */
#zenCentreToolbar {
    background-color: $window;
    border-bottom: 1px solid $border;
}
#zenCentreToolbar #search_bar { border: none; }

#zenViewSwitcher {
    background-color: $button;
    border: 1px solid $border_strong;
    border-radius: ${radius_control}px;
    padding: 4px 8px;
    font-weight: $weight_heading;
}
#zenViewSwitcher:hover { background-color: $button_hover; }
#zenViewSwitcher::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    width: ${indicator_size}px;
    height: ${indicator_size}px;
    image: $mark_chevron_down;
}

/* The preview. Everything in it is a real QLabel rather than something
   painted, because it is a handful of widgets that change on selection, not
   thousands of rows that change on every scroll -- so this is the one part of
   the centre where the look is a stylesheet again. */
#zenPreview { background-color: $window; }

#zenPreviewSeries {
    color: $muted;
    font-size: ${font_size_caption}px;
    font-weight: $weight_heading;
}

/* The one place the overlay sets a serif. A book's title is the thing on this
   screen that is most like a book, and the rest of the app stays in the UI
   family -- a serif is a signal here precisely because it is not used
   anywhere else. */
#zenPreviewTitle {
    font-family: '${font_family_serif}';
    font-size: ${preview_title_size}px;
    font-weight: $weight_heading;
}

#zenPreviewAuthors {
    color: $muted;
    font-size: ${preview_author_size}px;
}

#zenPreviewFacts {
    color: $muted;
    font-size: ${font_size_caption}px;
}

/* The description paints itself (ElidedLabel), so its colour is set from
   Chrome in code -- a QSS `color` would never reach a hand-rolled paintEvent.
   Only the size is a rule. */
#zenPreviewDescription { font-size: ${font_size_base}px; }

/* Quick actions. Read is outlined rather than filled: it is the most likely
   thing to press, not the only safe one, and a solid accent block above a row
   of flat buttons reads as louder than it deserves. The rest stay flat,
   because a row of six framed boxes is the thing the overlay set out to stop
   doing.

   Their labels are the ordinary text colour, not muted, because the icon pack
   renders every glyph in exactly that colour and a muted label beside a
   full-strength glyph is the mismatch you notice first. The muting that makes
   them read as secondary is the missing frame, not a paler word. */
#zenPreviewActions QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${radius_control}px;
    color: palette(window-text);
    padding: 3px 8px;
}
#zenPreviewActions QToolButton:hover { background-color: $hover; }
#zenPreviewActions QToolButton:pressed { background-color: $pressed; }
#zenPreviewActions QToolButton:disabled { color: $muted; }
#zenPreviewActions QToolButton::menu-indicator { image: none; width: 0px; }

#zenPreviewRead {
    background-color: transparent;
    border: 1px solid $accent;
    border-radius: ${radius_control}px;
    color: $accent;
    font-weight: $weight_heading;
    padding: 4px 14px;
}
#zenPreviewRead:hover { background-color: $hover; }
#zenPreviewRead:pressed { background-color: $pressed; }
#zenPreviewRead:disabled { border-color: $border_weak; color: $muted; }

#zenPreviewMore { font-size: 16px; font-weight: $weight_heading; }

/* Tags, as pills. A dynamic property rather than an objectName because there
   is one per tag and objectNames are meant to be unique. */
#zenPreview QLabel[zenPill="true"] {
    background-color: $alt;
    border: 1px solid $border_weak;
    border-radius: ${radius_control}px;
    color: palette(window-text);
    font-size: ${font_size_caption}px;
    padding: 2px 8px;
}

/* The quick actions over a hovered cover-grid tile. The bar is a scrim rather
   than a palette surface because it floats over artwork, not over the window;
   its glyphs are re-inked for it in tiles.py, since an action's icon is drawn
   in the window's text colour and would otherwise be black on black. */
#zenTileActions {
    background-color: $scrim;
    border-radius: ${grid_action_radius}px;
}
#zenTileActions QToolButton {
    background-color: transparent;
    border: none;
    border-radius: ${radius_row}px;
    padding: 0;
}
#zenTileActions QToolButton:hover { background-color: $hover; }
#zenTileActions QToolButton:pressed { background-color: $pressed; }
#zenTileActions QToolButton:disabled { opacity: 0.4; }
