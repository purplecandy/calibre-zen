/* Buttons */

QPushButton {
    background-color: $button;
    color: palette(button-text);
    border: 1px solid $border_strong;
    border-radius: ${radius_control}px;
    padding: $pad_button;
    min-height: ${control_min_height}px;
}

QPushButton:hover { background-color: $button_hover; }
QPushButton:pressed { background-color: $button_pressed; }
QPushButton:focus { border-color: $accent; }

/* :default is Qt's own signal for "this dialog's primary action" -- calibre
   sets it directly in ~30 places and QDialogButtonBox sets it automatically
   for the Accept-role button, no cooperation needed from this overlay. One
   solid accent button per dialog is meant to read as the one thing to do. */
QPushButton:default {
    background-color: $accent;
    border-color: $accent;
    color: $accent_text;
}
QPushButton:default:hover { background-color: $accent_hover; border-color: $accent_hover; }
QPushButton:default:pressed { background-color: $accent_pressed; border-color: $accent_pressed; }

QPushButton:disabled { background-color: transparent; border-color: $border_weak; color: $muted; }
QPushButton:default:disabled { background-color: transparent; border-color: $border_weak; color: $muted; }

QPushButton:flat { background-color: transparent; border-color: transparent; }
QPushButton:flat:hover { background-color: $hover; }

/* Qt has no "this is destructive" signal -- calibre never uses
   QDialogButtonBox's DestructiveRole -- so theme/variants.py tags a button
   given a known-dangerous icon (trash.png) with zenVariant instead. A tint,
   not a solid fill: a button-sized block of solid red is a stronger warning
   than most delete actions in this app deserve. */
QPushButton[zenVariant="destructive"] {
    background-color: $danger_bg;
    border-color: transparent;
    color: $danger;
}
QPushButton[zenVariant="destructive"]:hover,
QPushButton[zenVariant="destructive"]:pressed { background-color: $danger_bg_hover; }
QPushButton[zenVariant="destructive"]:disabled { background-color: transparent; border-color: $border_weak; color: $muted; }

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    width: ${indicator_size}px;
    height: ${indicator_size}px;
    image: $mark_chevron_down;
}

/* Toolbar buttons get no chrome at rest -- a row of framed boxes is most of
   what makes the stock toolbar read as a 2005 UI. */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${radius_control}px;
    padding: $pad_toolbutton;
}

QToolButton:hover { background-color: $hover; }
QToolButton:pressed { background-color: $pressed; }
QToolButton:checked { background-color: $pressed; border-color: $border; }

/* One arrow width for every button that has one, rather than a different
   reservation per popup mode: a toolbar whose buttons are each a slightly
   different width is the thing that reads as unevenly spaced. DelayedPopup is
   0, MenuButtonPopup 1, InstantPopup 2; only the last two draw an arrow. */
QToolButton[popupMode="1"], QToolButton[popupMode="2"] { padding-right: ${menu_arrow_room}px; }
QToolButton::menu-button {
    border: none;
    border-top-right-radius: ${radius_control}px;
    border-bottom-right-radius: ${radius_control}px;
    width: ${menu_arrow_room}px;
}
QToolButton::menu-button:hover { background-color: $pressed; }
/* MenuButtonPopup draws its arrow as menu-arrow in the menu-button strip;
   InstantPopup draws a menu-indicator tucked into the bottom right corner.
   Left alone the two sit at different heights in the same toolbar, which is
   the sort of thing that reads as "crooked" without being obviously wrong. */
QToolButton::menu-arrow, QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    width: ${indicator_size}px;
    height: ${indicator_size}px;
    image: $mark_chevron_down;
}
