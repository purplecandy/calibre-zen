/* The welcome wizard's last pages -- see calibre_zen/onboarding/. A recording
   under the wizard's own header, and on the last page the line about the
   Finish button. When there is no recording the pane paints its own dashed
   outline, so the sheet leaves the border alone. */

#zenOnboardingDemo { background-color: transparent; border: none; }
#zenOnboardingFooter { color: $muted; }

/* The first page when calibre is on the same computer: bring its settings
   over, or start fresh. A grouped form (18-forms.qss); here only the line
   under each choice and the values that were found. */
#zenImportNote, #zenImportValue { color: $muted; }
#zenImportStatus { font-weight: 600; }
#zenImportProblem { color: $danger; }
/* The folder buttons in the rows' tool slots: quiet, like the editor's
   field actions (15-editor.qss). */
#zenImportPick { background-color: transparent; border: 1px solid transparent; }
#zenImportPick:hover { background-color: $hover; }
#zenImportPick:pressed { background-color: $pressed; }
