/* Text entry and anything shaped like it */

QLineEdit, QPlainTextEdit, QTextEdit, QTextBrowser, QSpinBox, QDoubleSpinBox,
QDateEdit, QDateTimeEdit, QTimeEdit, QComboBox, QKeySequenceEdit {
    background-color: palette(base);
    border: 1px solid $border_strong;
    border-radius: ${radius_control}px;
    padding: $pad_field;
    min-height: ${control_min_height}px;
    selection-background-color: $accent;
    selection-color: $accent_text;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus, QComboBox:focus, QKeySequenceEdit:focus {
    border-color: $accent;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: transparent;
    border-color: $border_weak;
    color: $muted;
}

QLineEdit:read-only { background-color: $alt; }

QComboBox::drop-down { border: none; width: ${menu_arrow_room}px; }
QComboBox::down-arrow {
    width: ${indicator_size}px;
    height: ${indicator_size}px;
    image: $mark_chevron_down;
}
/* A combo box's list is dressed in qss/local/combo-list.qss, set on the
   window it drops into -- see theme/dropdowns.py for why it cannot be here. */

/* Spin boxes step with two chevrons at the right end, drawn like a combo box's
   arrow: no box of their own, a wash under the pointer. Styling the button
   subcontrol stops Qt drawing its native arrow, so the arrows are named too --
   a spin box whose buttons are styled and whose arrows are not has none. */
/* Two stacked buttons make a spin box taller than the fields beside it; held
   to the same content height as they are. */
QSpinBox, QDoubleSpinBox { padding-right: ${spin_button_width}px; max-height: ${control_min_height}px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: ${spin_button_width}px;
    border: none;
    background: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin: 2px 2px 0px 0px;
    border-top-right-radius: ${radius_row}px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0px 2px 2px 0px;
    border-bottom-right-radius: ${radius_row}px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: $hover; }
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed { background-color: $pressed; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: ${spin_arrow_size}px;
    height: ${spin_arrow_size}px;
    image: $mark_chevron_up;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: ${spin_arrow_size}px;
    height: ${spin_arrow_size}px;
    image: $mark_chevron_down;
}
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off,
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: none;
}
