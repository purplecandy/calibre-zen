// Icon and version resource for every executable package.ps1 builds: the
// launchers and the portable installer. package.ps1 fills in the @...@ fields
// before compiling, and appends the payload resource for the installer.
#include <winver.h>

1 ICON "calibre-zen.ico"

1 VERSIONINFO
FILEVERSION     @VERSION_COMMA@
PRODUCTVERSION  @VERSION_COMMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Nadeem Siddique"
            VALUE "FileDescription",  "@FILE_DESCRIPTION@"
            VALUE "FileVersion",      "@VERSION_DOT@"
            VALUE "InternalName",     "@INTERNAL_NAME@"
            VALUE "LegalCopyright",   "Copyright Kovid Goyal; calibre-zen fork copyright Nadeem Siddique. GPL v3."
            VALUE "OriginalFilename", "@INTERNAL_NAME@.exe"
            VALUE "ProductName",      "@DISPLAY_NAME@"
            VALUE "ProductVersion",   "@VERSION_DOT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
